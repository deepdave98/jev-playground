{"nodes": [{"id": "src_step6_email_system", "label": "SYSTEM email-writing prompt", "file_type": "code", "source_file": "week-01-lead-triage/src/step6_email.py", "source_location": "L28-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conditions the email on the triage judgments already made, so an enterprise ready_to_buy lead gets a different email from a mid-market evaluating one. Bans generic openers, exclamation marks and em dashes; 10 of 29 outputs contained an em dash anyway."}, {"id": "src_step6_email_prove_jev_cannot_write", "label": "prove_jev_cannot_write()", "file_type": "code", "source_file": "week-01-lead-triage/src/step6_email.py", "source_location": "L48-L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Posts a `text` question type to the live Jev API and prints the HTTP 400, demonstrating the limitation against the running service rather than asserting it in prose."}, {"id": "src_step6_email_main", "label": "step6_email.py main()", "file_type": "code", "source_file": "week-01-lead-triage/src/step6_email.py", "source_location": "L80-L134", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_step6_email_jev_has_no_text_primitive", "label": "Jev has no text primitive (HTTP 400)", "file_type": "rationale", "source_file": "week-01-lead-triage/src/step6_email.py", "source_location": "L1-L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jev exposes choice, score and noul and nothing that returns prose. Asking for text is not slow or bad, it is an api_usage_error. This is the step that makes the repo an architecture argument rather than a Jev advertisement."}, {"id": "src_step6_email_qualified_only_gating", "label": "Emails written only for ae_now and sdr_sequence leads", "file_type": "rationale", "source_file": "week-01-lead-triage/src/step6_email.py", "source_location": "L8-L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gating the expensive writing step on the cheap triage step is where the end-to-end saving comes from: 29 of 60 leads earned an email and the other 31 cost nothing to write to."}], "edges": [{"source": "src_step6_email_main", "target": "src_spec_route", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/step6_email.py", "source_location": "L96", "weight": 1.0}, {"source": "src_step6_email_main", "target": "src_claude_runner_calibrate", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/step6_email.py", "source_location": "L102", "weight": 1.0}, {"source": "src_step6_email_main", "target": "src_claude_runner__invoke", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/step6_email.py", "source_location": "L110", "weight": 1.0}, {"source": "src_step6_email_main", "target": "src_claude_runner_input_cost", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/step6_email.py", "source_location": "L114", "weight": 1.0}, {"source": "src_step6_email_main", "target": "src_step6_email_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/step6_email.py", "source_location": "L110", "weight": 1.0}, {"source": "src_step6_email_main", "target": "src_jev_runner_run", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "week-01-lead-triage/src/step6_email.py", "source_location": "L88-L95", "weight": 1.0}, {"source": "src_step6_email_qualified_only_gating", "target": "src_step6_email_main", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/step6_email.py", "sour