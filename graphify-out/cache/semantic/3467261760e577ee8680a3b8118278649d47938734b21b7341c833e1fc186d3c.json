{"nodes": [{"id": "week_02_deal_risk_src_claude_cli_fairness_corrections", "label": "Claude CLI fairness corrections (thinking off, CLI overhead subtracted, cache-rate billing)", "file_type": "rationale", "source_file": "week-02-deal-risk/src/claude.py", "source_location": "L3-L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same three corrections as week 01, since the claude CLI has not changed. call() turns thinking off (MAX_THINKING_TOKENS=0, --effort low) and strips the dynamic system prompt and all tools. calibrate() takes the median of five empty calls as the CLI's own scaffolding (2,822 tokens for Haiku and 3,823 for Sonnet this week) and cost() subtracts it. cost() bills cache writes at 1.25x and cache reads at 0.1x the input rate."}], "edges": [{"source": "week_02_deal_risk_src_claude_claude_ledger", "target": "week_02_deal_risk_src_spec_risk_rules_prose", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-02-deal-risk/src/claude.py", "source_location": "L58-L66", "weight": 1.0}, {"source": "week_02_deal_risk_src_claude_criteria_text", "target": "week_02_deal_risk_src_spec_signal_judgment", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-02-deal-risk/src/claude.py", "source_location": "L33-L34", "weight": 1.0}, {"source": "week_02_deal_risk_src_claude_criteria_text", "target": "week_02_deal_risk_src_spec_severity_judgment", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-02-deal-risk/src/claude.py", "source_location": "L35-L36", "weight": 1.0}, {"source": "week_02_deal_risk_src_claude_criteria_text", "target": "week_02_deal_risk_src_spec_exec_engaged_judgment", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-02-deal-risk/src/claude.py", "source_location": "L37", "weight": 1.0}, {"sourc