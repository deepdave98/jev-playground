{"nodes": [{"id": "src_spec_questions", "label": "QUESTIONS (shared typed question definitions)", "file_type": "code", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L20-L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single source of truth: Jev receives these dicts as typed questions and claude_runner renders the same strings as prose, so a rubric change lands on both sides at once. That is the only way the accuracy numbers mean anything."}, {"id": "src_spec_build_questions", "label": "build_questions()", "file_type": "code", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L100-L118", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_spec_route", "label": "route() deterministic routing rule", "file_type": "code", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L120-L136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 5 runs in code from the four judgments, applied identically to the answer key and to both models' output, so routing accuracy isolates judgment quality instead of mixing in a model's branching."}, {"id": "src_spec_competitor_clarification", "label": "COMPETITOR_CLARIFICATION (v2 prompt delta)", "file_type": "code", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L85-L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Round 1 said 'a direct competitor' and never said who that is, so Haiku threw out Workday, Atlassian, ServiceNow and Oracle for also selling software. That is a fair complaint about the prompt, not only the model, so round 2 names Clay, Apollo, ZoomInfo, Outreach and Salesloft and changes nothing else. Both models get it."}, {"id": "src_spec_product_context", "label": "PRODUCT_CONTEXT", "file_type": "code", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L11-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_spec_intent_levels", "label": "INTENT_LEVELS (ordered intent ladder)", "file_type": "code", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_spec_segments", "label": "SEGMENTS", "file_type": "code", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_spec_v1_v2_prompt_variants", "label": "v1 / v2 prompt variants", "file_type": "concept", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L100-L118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v1 is the prompt as originally written; v2 is v1 plus one sentence naming the competitor set on the disqualify question and nothing else, so the round-to-round delta is attributable to exactly that sentence. Unknown variant strings raise rather than silently falling back to v1."}, {"id": "src_spec_routing_in_code_not_model", "label": "Routing belongs in code, not a model", "file_type": "rationale", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L120-L122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five branches that are free, instant, testable and cannot drift. Spending a model call on a branch buys nothing and adds a failure mode you paid for. What the models are for is the four genuinely fuzzy judgments underneath."}, {"id": "src_spec_disqualify_question", "label": "Typed judgment: disqualify (noul / probability)", "file_type": "concept", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L21-L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asked as a noul (probability) question so the answer carries calibration, not just a boolean. Explicitly tells the model not to disqualify a real buyer for a personal email address, a short message, or a small company."}, {"id": "src_spec_icp_fit_question", "label": "Typed judgment: icp_fit (noul / probability)", "file_type": "concept", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L37-L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three conjunctive conditions (B2B, 50+ employees, revenue/marketing/ops/data/exec role), judged on company and role rather than email domain, and deliberately kept independent of disqualify."}, {"id": "src_spec_segment_question", "label": "Typed judgment: segment (choice)", "file_type": "concept", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L52-L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A choice question over enterprise / mid_market / smb driven by headcount, with inference from the company name only when headcount is missing. Every runner scores 95-100% on it, which is what makes it useful as a floor."}, {"id": "src_spec_intent_question", "label": "Typed judgment: intent (score over an ordered ladder)", "file_type": "concept", "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L66-L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modelled as a continuous score over four ordered levels rather than a choice, judging urgency and specificity of the message and not company quality. This is the one judgment where Jev loses to both Claude models."}], "edges": [{"source": "src_spec_disqualify_question", "target": "week_01_lead_triage_rubric_disqualify_rule", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L21-L36", "weight": 1.0}, {"source": "src_spec_icp_fit_question", "target": "week_01_lead_triage_rubric_icp_fit_rule", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L37-L51", "weight": 1.0}, {"source": "src_spec_segment_question", "target": "week_01_lead_triage_rubric_segment_rule", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L52-L65", "weight": 1.0}, {"source": "src_spec_intent_question", "target": "week_01_lead_triage_rubric_intent_rule", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L66-L78", "weight": 1.0}, {"source": "src_spec_questions", "target": "src_spec_disqualify_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L21", "weight": 1.0}, {"source": "src_spec_questions", "target": "src_spec_icp_fit_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L37", "weight": 1.0}, {"source": "src_spec_questions", "target": "src_spec_segment_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L52", "weight": 1.0}, {"source": "src_spec_questions", "target": "src_spec_intent_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L66", "weight": 1.0}, {"source": "src_spec_icp_fit_question", "target": "src_spec_product_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L40", "weight": 1.0}, {"source": "src_spec_build_questions", "target": "src_spec_questions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L108", "weight": 1.0}, {"source": "src_spec_build_questions", "target": "src_spec_competitor_clarification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L110", "weight": 1.0}, {"source": "src_spec_v1_v2_prompt_variants", "target": "src_spec_build_questions", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L100-L118", "weight": 1.0}, {"source": "src_spec_v1_v2_prompt_variants", "target": "src_spec_competitor_clarification", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L85-L98", "weight": 1.0}, {"source": "src_spec_routing_in_code_not_model", "target": "src_spec_route", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L120-L122", "weight": 1.0}, {"source": "src_spec_route", "target": "src_spec_intent_levels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L130", "weight": 1.0}, {"source": "src_spec_route", "target": "week_01_lead_triage_readme_recommended_architecture", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "week-01-lead-triage/src/spec.py", "source_location": "L120-L136", "weight": 1.0}], "hyperedges": [{"id": "four_typed_judgments_feed_the_routing_rule", "label": "Four typed judgments feed the deterministic routing rule", "nodes": ["src_spec_disqualify_question", "src_spec_icp_fit_question", "src_spec_segment_question", "src_spec_intent_question", "src_spec_route"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/spec.py"}]}