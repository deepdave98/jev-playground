{"nodes": [{"id": "claude_working_in_this_repo", "label": "Working in this repo (CLAUDE.md)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L1-L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repo instructions for agents: query the graph first, follow the house rules, re-run a week's benchmark after changing a prompt the MCP server loads, write plainly, and keep the API key out of git."}, {"id": "claude_graph_before_files", "label": "Query the graphify graph before reading files", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L3-L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify-out/ holds a knowledge graph so an agent does not burn a context window rediscovering how the benchmark fits together. Answers come back with file:line, and `graphify update` refreshes the graph after code changes."}, {"id": "claude_numbers_from_committed_runs", "label": "House rule: README numbers come from a committed run in results/raw/", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L29-L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never hand-edit a results table. If a number changes, re-run and re-score."}, {"id": "claude_keep_arithmetic_out_of_prompts", "label": "House rule: keep arithmetic out of prompts", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L36-L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thresholds, date windows and counts go in code. Week 02 measured the alternative: the same model scored 100% when code applied the rule and 70% when it applied the rule itself."}, {"id": "claude_writing_rules", "label": "Writing rules (plain English, no em dashes)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L47-L54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain English the way an engineer writes notes for another engineer: no em dashes, no 'it is not X, it is Y', no stock marketing words, no section that only restates the one above. Say the number, say what it means, move on."}, {"id": "claude_typesafe_api_key", "label": "TYPESAFE_API_KEY (kept in gitignored .env.local)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L56-L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lives in .env.local, which is gitignored and has never been committed. .env.example documents the shape."}], "edges": [{"source": "claude_working_in_this_repo", "target": "claude_graph_before_files", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L3", "weight": 1.0}, {"source": "claude_working_in_this_repo", "target": "claude_numbers_from_committed_runs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L29", "weight": 1.0}, {"source": "claude_working_in_this_repo", "target": "readme_fix_the_unfair_thing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L32-L34", "weight": 1.0}, {"source": "claude_working_in_this_repo", "target": "week_01_lead_triage_readme_week_01_lead_triage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L33", "weight": 1.0}, {"source": "claude_working_in_this_repo", "target": "claude_keep_arithmetic_out_of_prompts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L36", "weight": 1.0}, {"source": "claude_working_in_this_repo", "target": "mcp_server_jev_server", "relation": "references", "confidence": "EXTRACTE