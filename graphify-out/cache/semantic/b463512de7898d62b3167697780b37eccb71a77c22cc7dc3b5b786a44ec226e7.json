{"nodes": [{"id": "src_split_runner_claudesplitrunner", "label": "ClaudeSplitRunner", "file_type": "code", "source_file": "week-01-lead-triage/src/split_runner.py", "source_location": "L62-L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subclasses ClaudeRunner and replaces the single four-question prompt with four independent single-question prompts, which is the most favourable arrangement Claude can get. It is also 4x the calls, 4x the prompt overhead and 4x the latency, the part nobody mentions when they suggest it."}, {"id": "src_split_runner_single_question_prompt", "label": "single_question_prompt()", "file_type": "code", "source_file": "week-01-lead-triage/src/split_runner.py", "source_location": "L34-L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds a per-question prompt from the same criteria strings used everywhere else, so removing the combined format does not also change the wording."}, {"id": "src_split_runner_run", "label": "ClaudeSplitRunner.run()", "file_type": "code", "source_file": "week-01-lead-triage/src/split_runner.py", "source_location": "L71-L106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sums latency, tokens and cost across the four calls and reports requests=4, so the ablation's real overhead is visible in the same table as the single-call runs."}, {"id": "src_split_runner_main", "label": "split_runner.py main() with --resume", "file_type": "code", "source_file": "week-01-lead-triage/src/split_runner.py", "source_location": "L109-L152", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four calls per lead is slow enough that losing a part-done run hurts, so completed lead ids are read back from the output file and skipped on resume."}, {"id": "src_split_runner_error_correlation_hypothesis", "label": "Correlated-error hypothesis (Haiku conflates disqualify and icp_fit)", "file_type": "rationale", "source_file": "week-01-lead-triage/src/split_runner.py", "source_location": "L3-L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All 29 of Haiku's icp_fit errors ran the same direction and lined up with 27 over-disqualifications: it decided 'bad lead' once and wrote that answer into both fields. That could be an artifact of the single-JSON format rather than the model, so the ablation removes the format to test it."}], "edges": [{"source": "src_split_runner_error_correlation_hypothesis", "target": "src_split_runner_claudesplitrunner", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/split_runner.py", "source_location": "L3-L18", "weight": 1.0}, {"source": "src_split_runner_claudesplitrunner", "target": "src_claude_runner_clauderunner", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/split_runner.py", "source_location": "L62-L64", "weight": 1.0}, {"source": "src_split_runner_claudesplitrunner", "target": "src_split_runner_single_question_prompt", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/split_runner.py", "source_location": "L67", "weight": 1.0}, {"source": "src_split_runner_claudesplitrunner", "target": "src_spec_build_questions", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/split_runner.py", "source_location": "L66", "weight": 1.0}, {"source": "src_split_runner_run", "target": "src_claude_runner__invoke", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/split_runner.py", "source_location": "L80", "weight": 1.0}, {"source": "src_split_runner_run", "target": "src_claude_runner_build_user_prompt", "relation": "calls", "confidence"