{"nodes": [{"id": "src_score_pct", "label": "pct() nearest-rank percentile", "file_type": "code", "source_file": "week-01-lead-triage/src/score.py", "source_location": "L28-L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nearest-rank rather than interpolated, because n=60 and interpolation would be false precision."}, {"id": "src_score_brier", "label": "brier() Brier score", "file_type": "code", "source_file": "week-01-lead-triage/src/score.py", "source_location": "L38-L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mean squared error of the stated probability, lower is better. Jev's 0.041 against Sonnet's 0.130 is what makes an auto-approve / human-review confidence band a real workflow rather than a number a model made up to sound confident."}, {"id": "src_score_ece", "label": "ece() expected calibration error", "file_type": "code", "source_file": "week-01-lead-triage/src/score.py", "source_location": "L43-L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five-bin weighted gap between stated confidence and observed accuracy, with the top bin widened to include p == 1.0 so perfectly confident answers are not dropped."}, {"id": "src_score_score_file", "label": "score_file()", "file_type": "code", "source_file": "week-01-lead-triage/src/score.py", "source_location": "L58-L135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computes per-field accuracy, route accuracy via spec.route(), latency percentiles, cost per thousand, calibration on the two probability questions only, the two business error metrics, and a route confusion matrix."}, {"id": "src_score_main", "label": "score.py main()", "file_type": "code", "source_file": "week-01-lead-triage/src/score.py", "source_location": "L138-L184", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skips step6-emails.jsonl because it has a different shape and drops runs with zero completed rows, since a run still in flight has a header and no rows yet. Tables are grouped by prompt variant so v1 and v2 are never averaged together."}, {"id": "src_score_buyers_binned", "label": "Business error metric: funded buyers binned", "file_type": "concept", "source_file": "week-01-lead-triage/src/score.py", "source_location": "L91-L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts leads whose true route is ae_now but whose predicted route is reject. Accuracy treats every mistake the same; this one does not, because binning a funded buyer costs revenue. Haiku did it to 7 of 16, Sonnet to 1, Jev to 0."}, {"id": "src_score_competitors_leaked", "label": "Business error metric: disqualified leads leaked", "file_type": "concept", "source_file": "week-01-lead-triage/src/score.py", "source_location": "L99-L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts leads labelled disqualify that the model let through. Handing a competitor a demo costs something worse than revenue; this is where Jev's 2-of-12 competitor blind spot shows up against the 90% headline."}, {"id": "src_score_route_accuracy", "label": "Route accuracy (the end-to-end workflow metric)", "file_type": "concept", "source_file": "week-01-lead-triage/src/score.py", "source_location": "L84-L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How often the whole workflow put the lead in the right queue, which is the only number a GTM team feels. Computed by pushing both the prediction and the label through the same spec.route()."}], "edges": [{"source": "src_score_main", "target": "src_score_score_file", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "week-01-lead-triage/src/score.py", "source_location": "L144", "weight": 1.0},