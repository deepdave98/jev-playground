ME.md", "source_location": "L84-L87", "weight": 1.0}, {"source": "week_01_lead_triage_readme_recommended_architecture", "target": "mcp_server_readme_inbound_lead_workflow", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "mcp-server/README.md", "source_location": "L73-L90", "weight": 1.0}, {"source": "mcp_server_readme_monday_risk_sweep", "target": "week_02_deal_risk_readme_ackdb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mcp-server/README.md", "source_location": "L95", "weight": 1.0}, {"source": "mcp_server_readme_monday_risk_sweep", "target": "mcp_server_jev_server_ledger_dir", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mcp-server/README.md", "source_location": "L95", "weight": 1.0}, {"source": "mcp_server_readme_monday_risk_sweep", "target": "mcp_server_jev_server_deals_at_risk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mcp-server/README.md", "source_location": "L96", "weight": 1.0}, {"source": "mcp_server_readme_monday_risk_sweep", "target": "mcp_server_readme_slack_server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mcp-server/README.md", "source_location": "L99", "weight": 1.0}, {"source": "mcp_server_readme_monday_risk_sweep", "target": "week_02_deal_risk_rubric_at_risk_answer_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mcp-server/README.md", "source_location": "L108-L110", "weight": 1.0}, {"source": "mcp_server_readme_monday_risk_sweep", "target": "week_02_deal_risk_readme_review_step", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "mcp-server/README.md", "source_location": "L97-L98", "weight": 1.0}, {"source": "mcp_server_readme_monday_risk_sweep", "target": "week_02_deal_risk_readme_what_i_would_ship", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "mcp-server/README.md", "source_location": "L92-L115", "weight": 1.0}, {"source": "mcp_server_readme_monday_risk_sweep", "target": "mcp_server_readme_fan_out_inside_tool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mcp-server/README.md", "source_location": "L115", "weight": 1.0}, {"source": "mcp_server_readme_monday_risk_sweep", "target": "mcp_server_readme_no_agent_date_arithmetic", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "mcp-server/README.md", "source_location": "L97-L98", "weight": 1.0}, {"source": "mcp_server_readme_fan_out_inside_tool", "target": "mcp_server_jev_server_deals_at_risk", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mcp-server/README.md", "source_location": "L117-L137", "weight": 1.0}, {"source": "mcp_server_readme_fan_out_inside_tool", "target": "mcp_server_jev_server_deal_risk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mcp-server/README.md", "source_location": "L119-L122", "weight": 1.0}, {"source": "mcp_server_readme_tool_description_fix", "target": "mcp_server_jev_server_deals_at_risk", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mcp-server/README.md", "source_location": "L141-L148", "weight": 1.0}, {"source": "mcp_server_readme_tool_description_fix", "target": "mcp_server_jev_server_ledger_dir", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mcp-server/README.md", "source_location": "L142-L143", "weight": 1.0}, {"source": "mcp_server_readme_toolerror_for_expected_failures", "target": "mcp_server_jev_server_deals_at_risk", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence