#!/usr/bin/env python3
"""Check staged text for em and en dashes. Enable with core.hooksPath=.githooks."""

import re
import subprocess
import sys

# Built from code points so this file never contains the characters it bans.
EM, EN = chr(0x2014), chr(0x2013)
DASH = re.compile(f"[{EM}{EN}]")


def staged():
    out = subprocess.check_output(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"], text=True)
    return [p for p in out.split("\0") if p]


if __name__ == "__main__":
    bad = []
    for p in staged():
        blob = subprocess.check_output(["git", "show", f":{p}"])
        try:
            text = blob.decode("utf-8")
        except UnicodeDecodeError:
            continue
        bad += [f"{p}:{n}" for n, line in enumerate(text.splitlines(), 1) if DASH.search(line)]

    if bad:
        print("em or en dashes in staged files:", *bad[:20], sep="\n  ")
        print("\nRewrite the affected sentences before committing.")
        sys.exit(1)
